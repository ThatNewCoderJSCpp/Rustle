    update_states();
});

grove::get_by_id("mic-button").on("mouse_down", [](grove::Event&: e) -> void {
    auto: f = call("meters", "").split("\t");
    if (f.size() >= 8l && f[5] == "1" && f[7] == "1") then {
        call("talk", "1");
    }
});

grove::get_by_id("mic-button").on("mouse_up", [](grove::Event&: e) -> void {
    auto: f = call("meters", "").split("\t");
    if (f.size() >= 8l && f[5] == "1" && f[7] == "1") then {
        call("talk", "0");
    }
});

grove::get_by_id("mic-button").on("click", [](grove::Event&: e) -> void {
    auto: f = call("meters", "").split("\t");
    if (f.size() >= 8l && f[5] == "1" && f[7] == "1") then {
        return;
    }
    bool: on = f.size() >= 8l && f[7] == "1";
    call("set", tab2("mic_enabled", flag(!on)));
    update_meters();
});

grove::get_by_id("notice-close").on("click", [](grove::Event&: e) -> void {
