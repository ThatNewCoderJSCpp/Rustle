grove::get_by_id("fb-copy").on("click", [](grove::Event&: e) -> void {
    string: dest = grove::get_by_id("fb-target").value_string();
    if (dest.empty()) then {
        toast("error", "Pick a library folder to copy into. Add a folder to the library first if there isn't one.");
        return;
    }
    if (selected_count() == 0l) then {
        toast("error", "Tick the sound files you want to copy first.");
        return;
    }
    string: r = call("copy_into", dest + "\t" + fb_selected);
    if (failed(r)) then {
        toast("error", reason(r));
        return;
    }
    auto: f = r.split("\t");
    string: msg = "Copied " + f[1] + " sound file(s) into your library.";
    if (f.size() > 2l && !f[2].empty()) then {
        msg = msg + " Skipped: " + f[2];
    }
    toast("info", msg);
    fb_selected = "";
    toggle_selected("", false);
    open_dir(fb_path);
});

grove::get_by_id("settings").on("page_show", [](grove::Event&: e) -> void {
    load_settings_page();
});

grove::get_by_id("rescan").on("click", [](grove::Event&: e) -> void {
    call("rescan", "");
    toast("info", "Looking for new sounds...");
});

grove::get_by_id("rescan-interval").on("change", [](grove::Event&: e) -> void {
    if (filling) then {
        return;
    }
    call("set", tab2("rescan_seconds", e.target().value_string()));
});

grove::get_by_id("key-stop").on("click", [](grove::Event&: e) -> void {
    open_key_capture("stop", "The key that stops every sound that's playing.");
});

grove::get_by_id("key-mic").on("click", [](grove::Event&: e) -> void {
    open_key_capture("mic", "The key that turns your microphone on and off.");
});

grove::get_by_id("key-ptt").on("click", [](grove::Event&: e) -> void {
    open_key_capture("ptt", "Hold this key to talk while push to talk is on.");
});

grove::get_by_id("key-stop-clear").on("click", [](grove::Event&: e) -> void {
    call("set", tab2("key_stop_all", ""));
    load_settings_page();
});

grove::get_by_id("key-mic-clear").on("click", [](grove::Event&: e) -> void {
    call("set", tab2("key_mic_toggle", ""));
    load_settings_page();
});

grove::get_by_id("key-ptt-clear").on("click", [](grove::Event&: e) -> void {
