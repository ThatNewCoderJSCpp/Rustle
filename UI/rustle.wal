grove::get_by_id("nav-back").on("click", [](grove::Event&: e) -> void {
    if (view_mode != "folder") then {
        view_mode = "folder";
        query_text = "";
        filling = true;
        grove::get_by_id("search").set_value_string("");
        filling = false;
        build_board();
        return;
    }
    if (!cur_folder.empty()) then {
        enter_folder(parent_folder);
    }
});

function search_changed(const string&: typed) -> void {
    string: q = typed.trim();
    if (q == query_text) then {
        return;
    }
    query_text = q;
    if (q.empty()) then {
        view_mode = "folder";
    } else then {
        view_mode = "search";
    }
    build_board();
} end function search_changed

grove::get_by_id("search").on("input", [](grove::Event&: e) -> void {
    if (filling) then {
        return;
    }
    if (e.has_edit_text()) then {
        search_changed(e.edit_text());
    } else then {
        search_changed(e.target().value_string());
    }
});

grove::get_by_id("search").on("change", [](grove::Event&: e) -> void {
    if (filling) then {
        return;
    }
    search_changed(e.target().value_string());
});

grove::get_by_id("search").on("key_down", [](grove::Event&: e) -> void {
    if (e.key() == "Escape") then {
        filling = true;
        e.target().set_value_string("");
        filling = false;
        search_changed("");
    }
});

