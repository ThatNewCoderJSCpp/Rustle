    load_settings_page();
});

grove::get_by_id("global-keys").on("change", [](grove::Event&: e) -> void {
    if (filling) then {
        return;
    }
    call("set", tab2("global_hotkeys", flag(e.target().value_bool())));
    update_hotkeys();
});

edit_field("volume");
edit_field("speed");
edit_field("tempo");
edit_field("pitch");
edit_field("reverb");
edit_field("reverb_size");
edit_field("trim_start");
edit_field("trim_end");
edit_field("fade_in");
edit_field("fade_out");

grove::get_by_id("ed-reverse").on("change", [](grove::Event&: e) -> void {
    if (filling) then {
        return;
    }
    call("edit_set", tab3(edit_path, "reverse", flag(e.target().value_bool())));
});

grove::get_by_id("ed-loop").on("change", [](grove::Event&: e) -> void {
    if (filling) then {
        return;
    }
    call("edit_set", tab3(edit_path, "loop", flag(e.target().value_bool())));
});

grove::get_by_id("ed-fav").on("click", [](grove::Event&: e) -> void {
    bool: now = grove::get_by_id("ed-fav").inner_text() == "\u{2605}";
    call("favorite", tab2(edit_path, flag(!now)));
    if (now) then {
        set_text("ed-fav", "\u{2606}");
    } else then {
        set_text("ed-fav", "\u{2605}");
    }
});

grove::get_by_id("ed-preview").on("click", [](grove::Event&: e) -> void {
    string: r = call("edit_preview", edit_path);
    if (failed(r)) then {
        toast("error", reason(r));
    }
});

grove::get_by_id("ed-reset").on("click", [](grove::Event&: e) -> void {
    call("edit_reset", edit_path);
    open_edit(edit_path);
});

grove::get_by_id("ed-key").on("click", [](grove::Event&: e) -> void {
    open_key_capture("sound", "Pressing this key plays " + grove::get_by_id("ed-name").inner_text() + ", or stops it while it plays.");
});

grove::get_by_id("ed-key-clear").on("click", [](grove::Event&: e) -> void {
    call("keybind_set", tab2(edit_path, ""));
    grove::get_by_id("ed-key").set_inner_text(key_label(""));
});

grove::get_by_id("edit-modal").on("close", [](grove::Event&: e) -> void {
    edit_open = false;
    build_board();
});

grove::get_by_id("key-modal").on("close", [](grove::Event&: e) -> void {
    key_target = "";
});

string: startup = call("settings", "");
view_kind = setting(startup, "view");
filling = true;
grove::get_by_id("sort").set_value_string(setting(startup, "sort"));
grove::get_by_id("view").set_value_string(view_kind);
grove::get_by_id("overlap").set_value_bool(setting(startup, "overlap") == "1");
grove::get_by_id("quick-others").set_value_float(to_float(setting(startup, "others_volume")));
grove::get_by_id("quick-me").set_value_float(to_float(setting(startup, "me_volume")));
filling = false;
cur_folder = setting(startup, "last_folder");
lib_rev = call("lib_state", "").split("\t")[0];
build_board();
update_vmic_pill();
string: start_page = setting(startup, "start_page");
if (!start_page.empty()) then {
    grove::navigate(start_page);
}

grove::set_interval(100.0, []() -> void {
    update_meters();
    if (grove::get_by_id("sounds").is_current()) then {
        update_states();
    }
});

grove::set_interval(1000.0, []() -> void {
    check_library();
    update_notices();
    if (grove::get_by_id("output").is_current()) then {
        update_route();
    }
});

grove::set_interval(4000.0, []() -> void {
    if (!grove::get_by_id("output").is_current()) then {
        update_vmic_pill();
    }
});
